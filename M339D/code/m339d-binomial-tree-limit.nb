  RowBox[{"(*", " ", 
   RowBox[{"What", " ", "are", " ", "the", " ", "simulated", " ", "stock", " ", 
    RowBox[{"prices", "?"}]}], " ", "*)"}], " ", 
  RowBox[{
   RowBox[{
    RowBox[{"S0", "=", "100"}], ";", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "from", " ", "cointosses", " ", "to", " ", "stock", " ", "prices"}], " ",
      "*)"}], " ", 
    RowBox[{"S1Sims", "=", 
